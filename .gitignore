# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
# Scoped rather than bare `dist`: desktop/dist is a tracked directory (see
# desktop/.gitignore) and a bare pattern would exclude it wholesale, which no
# nested negation can undo.
web/dist
dist-ssr
*.local

# Dropped in web/ by wails to detect when frontend:install needs rerunning.
web/package.json.md5

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local env files — the backend reads backend/.env, and nothing committed needs one.
.env
