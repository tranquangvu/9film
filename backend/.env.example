# Server
PORT=8081
# Loopback by default — the app has no sign-in, so only expose it on the network
# if you mean to (HOST=0.0.0.0).
HOST=127.0.0.1

# DB — also where the API keys below live, once entered in Profile → Connections.
DB_PATH=./nicefilm.db

# There are no server-side API keys. Subtitles (SubDL) and the AI features
# (Gemini) each read the key you enter in Profile → Connections, and stay off
# until you do.
