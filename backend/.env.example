# Server
PORT=8081
HOST=0.0.0.0

# Auth / DB
JWT_SECRET=
TOKEN_TTL_HOURS=168
DB_PATH=./nicefilm.db

# Subtitles — which provider searches: subdl (default) | opensubtitles.
# Both stay available either way, so a track saved under the other one still plays.
SUBTITLE_PROVIDER=subdl

# SubDL (https://subdl.com/panel/api) — optional shared fallback key. Users can
# supply their own in Profile → Connections; search/download is disabled without either.
SUBDL_API_KEY=

# OpenSubtitles (legacy — only searched when SUBTITLE_PROVIDER=opensubtitles).
# Username/password are needed for downloads, not for search.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
