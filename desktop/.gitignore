# Copied from web/dist by the Makefile's frontend-build target. The directory is
# tracked (via .gitkeep) because //go:embed needs it to exist at compile time.
dist/*
!dist/.gitkeep

build/bin/

# `go build ./...` drops the binary here, named after the directory.
/desktop

# Generated by wails for its JS runtime bindings.
wailsjs/
